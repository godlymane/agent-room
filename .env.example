# Local LLM: no Anthropic credits required. Ollama must already be running locally.
# Hermes Agent also works through its OpenAI-compatible API at http://127.0.0.1:8642/v1.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5-coder:7b
LLM_MAX_TOKENS=2048

# Budget & Guardrails
INITIAL_BUDGET=0.00
APPROVAL_THRESHOLD=10.00
MAX_DAILY_SPEND=10.00

# Solana survival challenge. Defaults to simulation: no transaction is signed.
SOLANA_MODE=live
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Public address used to watch incoming USDC in simulation or live mode.
SOLANA_OPERATIONAL_ADDRESS=
# Keep the secret key only in server/.env; never expose it to the client or commit it.
SOLANA_OPERATIONAL_SECRET_KEY=
# Optional separate fee payer. It needs a small SOL balance and signs only to pay network fees.
SOLANA_FEE_PAYER_SECRET_KEY=
# Native Circle USDC on Solana mainnet.
SOLANA_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
SOLANA_TREASURY_ADDRESS=49NHJ5aUPpVwjMrHzgJt7pcYPCi7cxHUXVoEhgBPrAgE
SOLANA_OPERATIONAL_CAP_USDC=50
SOLANA_DEBT_TARGET_USDC=35000

# Real trading — Solana only, via Jupiter. Off by default.
ENABLE_SOLANA_TRADING=false
# Get a key at https://developers.jup.ag/portal — required for any jupiter_* tool, even quotes.
JUPITER_API_KEY=
JUPITER_BASE_URL=https://api.jup.ag
# Hard cap per position; also bounded by SOLANA_OPERATIONAL_CAP_USDC across all open positions combined.
SOLANA_MAX_POSITION_USDC=25
# Stop-loss is self-hosted: the server polls price and market-sells on breach. It only protects
# open positions while this process is running, so don't stop the server with positions open.
SOLANA_TRADING_POLL_MS=60000

# Optional but strongly recommended when serving this beyond localhost.
ADMIN_API_TOKEN=
CORS_ORIGIN=http://localhost:5173
HOST=127.0.0.1
# Disabled by default: an LLM must not receive unrestricted shell access.
ENABLE_SHELL_TOOL=false
AGENT_WORKSPACE_DIR=
AGENT_OUTPUT_DIR=

# Optional - GitHub Publishing
GITHUB_TOKEN=

# Optional - Dev.to Articles
DEVTO_API_KEY=

# Optional - Gumroad (product listing only, creation must be manual)
GUMROAD_ACCESS_TOKEN=
